<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Serva.App.Views.ComparePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Serva.App.ViewModels"
    xmlns:models="using:Serva.Core.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- 日志一行：时间 / 路径·消息 / 操作 / 结果 -->
        <DataTemplate x:Key="LogRowTemplate" x:DataType="vm:LogRowViewModel">
            <Grid ColumnDefinitions="100,*,120,60" ColumnSpacing="12">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{x:Bind TimeText}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{x:Bind DetailText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind DetailText}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{x:Bind KindText}" />
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind ResultBrush}"
                    Text="{x:Bind ResultText}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel
                MaxWidth="1280"
                Padding="{StaticResource ServaPagePadding}"
                HorizontalAlignment="Left"
                Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind Text.CompareTitle, Mode=OneWay}" />
            </StackPanel>

            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasBanner, Mode=OneWay}"
                Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}"
                CloseButtonClick="Banner_CloseClick"
                Severity="{x:Bind ViewModel.BannerSeverity, Mode=OneWay}" />

            <!-- 版本更新提示：「查看更新」打开 GitHub 上最新的 Release 页面 -->
            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasUpdateNotice, Mode=OneWay}"
                Message="{x:Bind ViewModel.UpdateNoticeText, Mode=OneWay}"
                Severity="Informational"
                CloseButtonClick="UpdateNotice_CloseClick">
                <InfoBar.ActionButton>
                    <HyperlinkButton
                        Content="{x:Bind Text.OpenRelease, Mode=OneWay}"
                        NavigateUri="{x:Bind ViewModel.UpdateUri, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

                <!-- ========================= 移动设备与对应关系 ========================= -->
                <Grid ColumnDefinitions="*,1.6*" ColumnSpacing="16">
                    <Border Grid.Column="1" Style="{StaticResource ServaCard}">
                        <StackPanel Spacing="10">
                            <!-- 同上：标题 + 摘要占 * 列，「添加对应关系」按钮固定在最右列，不会被挤出卡片 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE8B7;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Text.MappingsTitle, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.MappingSummary, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="3"
                                    Click="AddMapping_Click"
                                    Content="{x:Bind Text.AddMapping, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanAddMapping, Mode=OneWay}" />
                            </Grid>

                            <ListView
                                MaxHeight="200"
                                ItemsSource="{x:Bind ViewModel.Mappings}"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="4,0" />
                                        <Setter Property="MinHeight" Value="40" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MappingViewModel">
                                        <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{x:Bind LocalRoot}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind LocalRoot}" />
                                            <FontIcon
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE71B;"
                                                ToolTipService.ToolTip="{x:Bind Text.MappingLinkTooltip, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{x:Bind DeviceDisplay}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind DeviceDisplay}" />
                                            <Button
                                                Grid.Column="3"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="RemoveMapping_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="{x:Bind Text.RemoveMappingTooltip, Mode=OneWay}">
                                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ServaCard}">
                        <StackPanel Spacing="10">
                            <!-- 标题占 * 列并允许省略：卡片再窄也别把「重新扫描」按钮挤出去 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE88E;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Text.DevicesTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="2"
                                    Command="{x:Bind ViewModel.RefreshDevicesCommand}"
                                    Content="{x:Bind Text.Rescan, Mode=OneWay}" />
                            </Grid>

                            <ListView
                                MaxHeight="200"
                                ItemsSource="{x:Bind ViewModel.Devices}"
                                SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                                SelectionMode="Single"
                                IsItemClickEnabled="True"
                                ItemClick="Device_ItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DeviceInfo">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="13" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind CapacityText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================== 执行中 ============================== -->
                <Border Style="{StaticResource ServaCard}" Visibility="{x:Bind ViewModel.RunningVisibility, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressRing
                                Width="56"
                                Height="56"
                                IsActive="True"
                                Value="{x:Bind ViewModel.RunningPercent, Mode=OneWay}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.RunningCountText, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.RunningDetailText, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.CancelCommand}"
                                Content="{x:Bind Text.CancelRun, Mode=OneWay}" />
                        </Grid>

                        <ProgressBar Maximum="100" Value="{x:Bind ViewModel.RunningPercent, Mode=OneWay}" />

                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.RunningCurrentFile, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                            <Border Padding="12" Style="{StaticResource ServaCard}">
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.RunningCompletedText, Mode=OneWay}" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Text.RunCompleted, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="12" Style="{StaticResource ServaCard}">
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.RunningQueuedText, Mode=OneWay}" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Text.RunQueued, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="12" Style="{StaticResource ServaCard}">
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.RunningSkippedText, Mode=OneWay}" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Text.RunSkipped, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Padding="12" Style="{StaticResource ServaCard}">
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.RunningFailedText, Mode=OneWay}" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Text.RunFailed, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================== 日志（已并入本页） ============================== -->
                <Border Style="{StaticResource ServaCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource ServaSectionTitle}" Text="{x:Bind Text.LogTitle, Mode=OneWay}" />

                        <!-- 搜索框保底 200：窗口窄下去时先压缩左边的「上次同步」说明，不会把搜索框和按钮挤没 -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" MinWidth="200" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="{x:Bind Log.LastSyncCaption, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Log.LastSyncCaption, Mode=OneWay}" />

                            <AutoSuggestBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="{x:Bind Text.LogSearchPlaceholder, Mode=OneWay}"
                                QueryIcon="Find"
                                Text="{x:Bind Log.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button Click="Undo_Click" IsEnabled="{x:Bind Log.CanUndo, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Log.UndoCaption, Mode=OneWay}" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind Text.ClearLog, Mode=OneWay}"
                                    Click="ClearLog_Click"
                                    IsEnabled="{x:Bind Log.CanClearLog, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind Text.ClearLogTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                        <TextBlock Text="{x:Bind Text.ClearLog, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <InfoBar
                            IsClosable="True"
                            IsOpen="{x:Bind Log.HasStatus, Mode=OneWay}"
                            Message="{x:Bind Log.StatusMessage, Mode=OneWay}"
                            CloseButtonClick="LogStatus_CloseClick"
                            Severity="{x:Bind Log.StatusSeverity, Mode=OneWay}" />

                        <Border
                            Padding="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowDefinitions="Auto,*">
                                <Grid
                                    Padding="16,10"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    ColumnDefinitions="100,*,120,60"
                                    ColumnSpacing="12">
                                    <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold" Text="{x:Bind Text.ColumnTime, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{x:Bind Text.ColumnPathMessage, Mode=OneWay}" />
                                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Text="{x:Bind Text.ColumnOperation, Mode=OneWay}" />
                                    <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Text="{x:Bind Text.ColumnResult, Mode=OneWay}" />
                                </Grid>

                                <ListView
                                    x:Name="LogList"
                                    Grid.Row="1"
                                    MaxHeight="320"
                                    ItemTemplate="{StaticResource LogRowTemplate}"
                                    ItemsSource="{x:Bind Log.Rows}"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="16,0" />
                                            <Setter Property="MinHeight" Value="40" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ======================== 底部命令栏：扫描按钮固定在窗口右下角 ======================== -->
        <Border
            Grid.Row="1"
            Padding="20,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Button
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Bind Text.ScanButton, Mode=OneWay}"
                Click="Scan_Click"
                IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE721;" />
                    <TextBlock Text="{x:Bind Text.ScanButton, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</Page>
