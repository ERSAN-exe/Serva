<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Serva.App.Views.CompareResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Serva.App.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- 盘符卡片：小字角色 + 大字盘符 -->
        <DataTemplate x:Key="DriveCardTemplate" x:DataType="vm:DriveCardViewModel">
            <Border
                MinWidth="150"
                Padding="14,8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind RoleText}" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind DriveText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="ServaCompareRow" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <!-- 状态 chip：低透明度底色 + 同色文字 -->
        <DataTemplate x:Key="StatusChipTemplate" x:DataType="vm:CompareRowViewModel">
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border
                    Background="{x:Bind StatusBrush}"
                    CornerRadius="10"
                    Opacity="0.16" />
                <TextBlock
                    Margin="8,2"
                    FontSize="12"
                    Foreground="{x:Bind StatusBrush}"
                    Text="{x:Bind StatusText}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            MaxWidth="1280"
            HorizontalAlignment="Left"
            Padding="{StaticResource ServaPagePadding}"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================== 标题 + 返回 ============================== -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Click="Back_Click" ToolTipService.ToolTip="{x:Bind Text.BackToCompareTooltip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE72B;" />
                        <TextBlock Text="{x:Bind Text.Back, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind Text.ResultTitle, Mode=OneWay}" />
            </StackPanel>

            <!-- ============================== 执行方式 ============================== -->
            <Border Grid.Row="1" Style="{StaticResource ServaCard}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Margin="0"
                        Style="{StaticResource ServaSectionTitle}"
                        Text="{x:Bind Text.ActionTitle, Mode=OneWay}" />

                    <!-- 盘符卡片固定不动，切换选项时只有中间的图标变化。 -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ContentControl Content="{x:Bind ViewModel.LocalCard, Mode=OneWay}" ContentTemplate="{StaticResource DriveCardTemplate}" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.ActionIconGlyph, Mode=OneWay}" />
                        <ContentControl Content="{x:Bind ViewModel.DeviceCard, Mode=OneWay}" ContentTemplate="{StaticResource DriveCardTemplate}" />
                    </StackPanel>

                    <!-- 选项（放在盘符卡片下方） -->
                    <RadioButtons MaxColumns="3" SelectedIndex="{x:Bind ViewModel.ActionIndex, Mode=TwoWay}">
                        <RadioButton AutomationProperties.Name="{x:Bind Text.ActionMerge, Mode=OneWay}" Content="{x:Bind Text.ActionMerge, Mode=OneWay}" />
                        <RadioButton AutomationProperties.Name="{x:Bind Text.ActionOverwriteDevice, Mode=OneWay}" Content="{x:Bind Text.ActionOverwriteDevice, Mode=OneWay}" />
                        <RadioButton AutomationProperties.Name="{x:Bind Text.ActionOverwriteLocal, Mode=OneWay}" Content="{x:Bind Text.ActionOverwriteLocal, Mode=OneWay}" />
                    </RadioButtons>

                    <!-- 提示：合并为蓝色 -->
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource ServaHintBrush}"
                        Text="{x:Bind ViewModel.MergeHintText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.MergeHintVisibility, Mode=OneWay}" />

                    <!-- 提示：用本机内容覆盖设备 —— 覆盖说明为红色，其后为黑色说明 +「执行策略」跳转 -->
                    <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.OverwriteLocalHintVisibility, Mode=OneWay}">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.OverwriteLocalHintText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{x:Bind Text.DeviceFilesHandledPrefix, Mode=OneWay}" />
                            <Button
                                Padding="6,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OpenSettings_Click"
                                ToolTipService.ToolTip="{x:Bind Text.OpenSettingsTooltip, Mode=OneWay}">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource ServaHintBrush}"
                                    Text="{x:Bind Text.ActionPolicy, Mode=OneWay}"
                                    TextDecorations="Underline" />
                            </Button>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{x:Bind Text.DeviceFilesHandledSuffix, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 提示：用设备内容覆盖本机硬盘（整句红色） -->
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.OverwriteDeviceHintText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.OverwriteDeviceHintVisibility, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- ============================== 比较结果 ============================== -->
            <Border
                Grid.Row="2"
                Padding="0"
                Style="{StaticResource ServaCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Padding="16,14,16,10"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                        <TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ServaSectionTitle}"
                            Text="{x:Bind Text.ResultTitle, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <ToggleSwitch
                            Grid.Column="2"
                            IsOn="{x:Bind ViewModel.ShowOnlyDifferences, Mode=TwoWay}"
                            OffContent="{x:Bind Text.ShowOnlyDifferences, Mode=OneWay}"
                            OnContent="{x:Bind Text.ShowOnlyDifferences, Mode=OneWay}" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Padding="16,8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        ColumnDefinitions="34,*,56,86,84,100"
                        ColumnSpacing="8">
                        <CheckBox
                            Grid.Column="0"
                            MinWidth="0"
                            IsChecked="{x:Bind ViewModel.IsAllSelected, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{x:Bind Text.ColumnFileName, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{x:Bind Text.ColumnSize, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="3"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{x:Bind Text.ColumnModified, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{x:Bind Text.ColumnStatus, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="5"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{x:Bind Text.ColumnAction, Mode=OneWay}" />
                    </Grid>

                    <!-- 行列表：只有这里滚动 -->
                    <ListView
                        Grid.Row="2"
                        ItemContainerStyle="{StaticResource ServaCompareRow}"
                        ItemsSource="{x:Bind ViewModel.Rows}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CompareRowViewModel">
                                <Grid ColumnDefinitions="34,*,56,86,84,100" ColumnSpacing="8">
                                    <CheckBox
                                        Grid.Column="0"
                                        MinWidth="0"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Bind FileName}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind RelativePath}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Bind SizeText}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Bind ModifiedText}" />
                                    <ContentControl
                                        Grid.Column="4"
                                        HorizontalContentAlignment="Left"
                                        Content="{x:Bind}"
                                        ContentTemplate="{StaticResource StatusChipTemplate}" />
                                    <TextBlock
                                        Grid.Column="5"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Bind ActionText}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 过滤后没有条目时的空态 -->
                    <TextBlock
                        Grid.Row="2"
                        Margin="16,12"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Text.EmptyRows, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.RowsEmptyVisibility, Mode=OneWay}" />
                </Grid>
            </Border>


        </Grid>

        <!-- ============================== 命令栏 ============================== -->
        <Border
            Grid.Row="1"
            Padding="20,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="Back_Click" Content="{x:Bind Text.Cancel, Mode=OneWay}" />
                <Button
                    AutomationProperties.Name="{x:Bind Text.StartRun, Mode=OneWay}"
                    Click="Start_Click"
                    IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="{x:Bind Text.StartRun, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
