<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Serva 设计令牌（Fluent Design）
        布局与信息架构参照 index.html / gallery.html；
        视觉语言映射为 WinUI 3 Fluent（Mica、层级填充、语义状态色）。
    -->

    <!-- ============================ 间距 / 圆角 ============================ -->
    <Thickness x:Key="ServaPagePadding">28,16,28,28</Thickness>
    <Thickness x:Key="ServaCardPadding">16</Thickness>
    <Thickness x:Key="ServaCardHeaderPadding">16,14,16,10</Thickness>
    <x:Double x:Key="ServaSectionSpacing">24</x:Double>
    <CornerRadius x:Key="ServaCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ServaChipCornerRadius">12</CornerRadius>

    <!-- ============================ 跨页面共用样式 ============================
         放在应用级字典里，比较页 / 设置页 / 日志页都能引用。
         这里刻意不使用 BasedOn（合并字典内无法用 StaticResource 引用另一个字典的键）。
    -->
    <Style x:Key="ServaSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="ServaCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ============================ 状态语义色 ============================
         使用 Fluent 系统语义色，自动适配明暗主题。
    -->
    <SolidColorBrush x:Key="ServaStatusLeftNewerBrush" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="ServaStatusRightNewerBrush" Color="#0B6BCB" />
    <SolidColorBrush x:Key="ServaStatusLeftOnlyBrush" Color="{ThemeResource SystemFillColorSuccess}" />
    <SolidColorBrush x:Key="ServaStatusRightOnlyBrush" Color="#00696D" />
    <SolidColorBrush x:Key="ServaStatusSameBrush" Color="{ThemeResource SystemFillColorNeutral}" />
    <SolidColorBrush x:Key="ServaStatusConflictBrush" Color="{ThemeResource SystemFillColorCaution}" />
    <SolidColorBrush x:Key="ServaStatusDeleteBrush" Color="{ThemeResource SystemFillColorCritical}" />

</ResourceDictionary>
