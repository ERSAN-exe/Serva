<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        随主题变化的画笔（主题字典必须独占一个字典文件：
        与普通资源混在同一个 ResourceDictionary 里会触发 XAML 编译器 WMC0035）。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- 蓝色说明文字（用于「执行方式」下方的提示）。 -->
            <SolidColorBrush x:Key="ServaHintBrush" Color="#0B6BCB" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ServaHintBrush" Color="#6CB8FF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ServaHintBrush" Color="#6CB8FF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
